# Copy this file to .env and fill in real values. Never commit .env.

# Local Docker database (matches compose.yaml):
DATABASE_URL=postgres://bakery:bakery@localhost:5432/bakery
# Neon (production, set in Vercel's Environment Variables instead of here).
# Use the *pooled* connection string, the one with "-pooler" in the host:
# DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

PORT=4000

# Email (replies to contact messages). In Docker these point at Mailpit automatically.
# Production example with Resend (https://resend.com), set in Vercel's Environment Variables:
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_your_api_key
# MAIL_FROM=Chez Hayet Bakery <orders@chezhayetoh.com>
# MAIL_REPLY_TO=hayets-own-inbox@example.com
